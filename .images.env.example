# Resolve and append @sha256:<64 hex digits> to every base image before production deployment.
# Shared by the API, Worker, Migrator and Gateway builds.
DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0.300
ASPNET_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0.8
DOTNET_RUNTIME_IMAGE=mcr.microsoft.com/dotnet/runtime:10.0.8
NODE_IMAGE=node:24.15.0-alpine
NGINX_IMAGE=nginx:1.29-alpine
