{
  "Agent": {
    "SocketPath": "/run/whaledeck/agent.sock",
    "OperationDirectory": "/var/lib/whaledeck-agent/operations",
    "MaintenanceStatusPath": "/run/whaledeck/maintenance/status.json",
    "CapabilityKeyFile": "/etc/whaledeck/agent-capability.key",
    "PlanDirectory": "/var/lib/whaledeck-agent/plans",
    "ResourceRegistryFile": "/etc/whaledeck/resources.json"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning"
      }
    }
  }
}
