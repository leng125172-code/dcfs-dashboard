# Optional non-interactive installer settings. Do not commit a populated copy.
WHALEDECK_INSTALL_ROOT=/data/GitRepos
WHALEDECK_DATABASE_REPOSITORY=https://github.com/leng125172-code/database-platform.git
WHALEDECK_DATABASE_BRANCH=main
WHALEDECK_SOURCE_REPOSITORY=https://github.com/leng125172-code/whale-deck.git
WHALEDECK_SOURCE_BRANCH=master

# Set to y/n. When y, provide your own Xuanyuan tenant mirror URL.
WHALEDECK_CONFIGURE_MIRROR=n
WHALEDECK_REGISTRY_MIRROR=https://<tenant-id>.xuanyuan.run

# Required only for the final Whale Deck deployment stage.
WHALEDECK_OIDC_INTERNAL_AUTHORITY=http://192.168.22.19:8081/application/o/whaledeck-internal/
WHALEDECK_OIDC_INTERNAL_CLIENT_ID=
WHALEDECK_OIDC_INTERNAL_CLIENT_SECRET=
WHALEDECK_OIDC_EXTERNAL_AUTHORITY=http://192.168.100.13:8081/application/o/whaledeck-external/
WHALEDECK_OIDC_EXTERNAL_CLIENT_ID=
WHALEDECK_OIDC_EXTERNAL_CLIENT_SECRET=
WHALEDECK_AUTHENTIK_API_TOKEN=
WHALEDECK_AUTHENTIK_ADMIN_GROUP_ID=
