[Unit]
Description=Whale Deck stable maintenance and reverse proxy endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=whaledeck-maintenance
Group=whaledeck
WorkingDirectory=/opt/whaledeck-maintenance
ExecStart=/opt/whaledeck-maintenance/WhaleDeck.MaintenanceHost
Restart=always
RestartSec=3s
Environment=Maintenance__Urls=http://0.0.0.0:8080;http://0.0.0.0:8081
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
# AF_NETLINK is read-only here and is required to resolve which local
# interface owns the request destination address. Container bridge interfaces
# are then rejected by the application before proxying.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadOnlyPaths=-/run/whaledeck/maintenance

[Install]
WantedBy=multi-user.target
