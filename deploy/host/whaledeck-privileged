#!/usr/bin/env bash
set -Eeuo pipefail

[[ $EUID -eq 0 ]] || { echo 'This helper must run as root.' >&2; exit 1; }
action=${1:-}

case "$action" in
  self-check)
    [[ $# -eq 1 ]] || exit 2
    printf 'ok\n'
    ;;
  docker-validate)
    [[ $# -eq 2 && "$2" == /etc/docker/daemon.json.whaledeck-candidate ]] || exit 2
    exec /usr/bin/dockerd --validate --config-file "$2"
    ;;
  docker-stage)
    [[ $# -eq 1 ]] || exit 2
    temporary=$(/usr/bin/mktemp /etc/docker/daemon.json.whaledeck-candidate.XXXXXX)
    trap '/usr/bin/rm -f -- "$temporary"' EXIT
    /usr/bin/timeout 5 /usr/bin/head -c 65537 > "$temporary"
    [[ $(/usr/bin/stat -c %s "$temporary") -le 65536 ]] || exit 2
    /usr/bin/jq -e 'type == "object"' "$temporary" >/dev/null
    /usr/bin/install -o root -g root -m 0644 "$temporary" /etc/docker/daemon.json.whaledeck-candidate
    ;;
  docker-apply)
    [[ $# -eq 2 && "$2" == /etc/docker/daemon.json.whaledeck-candidate ]] || exit 2
    /usr/bin/install -o root -g root -m 0644 /etc/docker/daemon.json /etc/docker/daemon.json.whaledeck-backup
    /usr/bin/install -o root -g root -m 0644 "$2" /etc/docker/daemon.json
    if ! /usr/bin/systemctl restart docker.service; then
      /usr/bin/install -o root -g root -m 0644 /etc/docker/daemon.json.whaledeck-backup /etc/docker/daemon.json
      /usr/bin/systemctl restart docker.service
      exit 1
    fi
    ;;
  docker-rollback)
    [[ $# -eq 1 && -f /etc/docker/daemon.json.whaledeck-backup ]] || exit 2
    /usr/bin/install -o root -g root -m 0644 /etc/docker/daemon.json.whaledeck-backup /etc/docker/daemon.json
    exec /usr/bin/systemctl restart docker.service
    ;;
  system-update-check)
    [[ $# -eq 1 ]] || exit 2
    exec /usr/bin/apt-get --simulate upgrade
    ;;
  system-update-install)
    [[ $# -eq 1 ]] || exit 2
    /usr/bin/apt-get update
    exec /usr/bin/apt-get --yes upgrade
    ;;
  systemd)
    [[ $# -eq 3 ]] || exit 2
    unit=$2
    verb=$3
    [[ "$unit" =~ ^(docker|database-platform-workstation-update|whaledeck-agent|whaledeck-maintenance)\.(service|timer)$ ]] || exit 2
    [[ "$verb" =~ ^(start|stop|restart)$ ]] || exit 2
    exec /usr/bin/systemctl "$verb" "$unit"
    ;;
  systemd-schedule)
    [[ $# -eq 3 ]] || exit 2
    unit=$2
    verb=$3
    [[ "$unit" == whaledeck-agent.service && "$verb" == restart ]] || exit 2
    exec /usr/bin/systemd-run --unit=whaledeck-agent-restart --collect --on-active=3s /usr/bin/systemctl restart "$unit"
    ;;
  database-backup)
    [[ $# -eq 7 ]] || exit 2
    engine=$2
    verb=$3
    critical_percent=$4
    retention_days=$5
    retention_count=$6
    verify_after_backup=$7
    [[ "$engine" =~ ^(postgres|mariaDb|mongoDb|sqlServer|valkey|valkey72)$ ]] || exit 2
    [[ "$verb" =~ ^(run|verify)$ ]] || exit 2
    [[ "$critical_percent" =~ ^[0-9]+$ && "$critical_percent" -ge 51 && "$critical_percent" -le 99 ]] || exit 2
    [[ "$retention_days" =~ ^[0-9]+$ && "$retention_days" -ge 1 && "$retention_days" -le 3650 ]] || exit 2
    [[ "$retention_count" =~ ^[0-9]+$ && "$retention_count" -ge 1 && "$retention_count" -le 365 ]] || exit 2
    [[ "$verify_after_backup" == true || "$verify_after_backup" == false ]] || exit 2
    if [[ "$verb" == run ]]; then
      used_percent=$(/usr/bin/df --output=pcent /data/DockerData | /usr/bin/tail -n 1 | /usr/bin/tr -dc '0-9')
      [[ -n "$used_percent" && "$used_percent" -lt "$critical_percent" ]] || {
        echo 'Backup target has reached the configured critical capacity threshold.' >&2
        exit 75
      }
      export BACKUP_RETENTION_DAYS="$retention_days" BACKUP_RETENTION_COUNT="$retention_count"
      "/data/GitRepos/database-platform/$engine/scripts/backup.sh" >&2
      if [[ "$verify_after_backup" == true ]]; then
        "/data/GitRepos/database-platform/$engine/scripts/verify-backup.sh" >&2
      fi
    else
      verify_after_backup=true
      "/data/GitRepos/database-platform/$engine/scripts/verify-backup.sh" >&2
    fi
    export BACKUP_VERIFIED="$verify_after_backup"
    exec /data/GitRepos/database-platform/scripts/backup-metadata.sh "$engine"
    ;;
  platform-update-schedule)
    [[ $# -eq 1 ]] || exit 2
    exec /usr/bin/systemd-run --unit=whaledeck-platform-update --collect --on-active=3s /usr/local/libexec/whaledeck-platform-maintenance update
    ;;
  platform-rollback-schedule)
    [[ $# -eq 1 ]] || exit 2
    exec /usr/bin/systemd-run --unit=whaledeck-platform-rollback --collect --on-active=3s /usr/local/libexec/whaledeck-platform-maintenance rollback
    ;;
  reboot)
    [[ $# -eq 1 ]] || exit 2
    exec /usr/bin/systemctl reboot
    ;;
  reboot-schedule)
    [[ $# -eq 1 ]] || exit 2
    exec /usr/bin/systemd-run --unit=whaledeck-reboot --collect --on-active=5s /usr/bin/systemctl reboot
    ;;
  *)
    echo 'Unsupported privileged action.' >&2
    exit 2
    ;;
esac
