[Unit]
Description=Whale Deck host management agent
Documentation=file:/opt/whaledeck-agent/README.md
Wants=docker.service
After=docker.service network-online.target

[Service]
Type=simple
User=whaledeck-agent
Group=whaledeck
SupplementaryGroups=docker systemd-journal
WorkingDirectory=/opt/whaledeck-agent
EnvironmentFile=/etc/whaledeck/agent.env
ExecStart=/opt/whaledeck-agent/WhaleDeck.Agent
Restart=on-failure
RestartSec=5s
RuntimeDirectory=whaledeck whaledeck/maintenance
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
StateDirectory=whaledeck-agent
StateDirectoryMode=0750
UMask=0007
PrivateTmp=true
PrivateDevices=false
ProtectHome=true
ProtectSystem=strict
# Docker settings are still protected by Unix ownership, sudoers and the
# fixed-action helper. This mount exception only lets that root helper stage,
# apply and roll back daemon.json from inside the service sandbox.
ReadWritePaths=/run/whaledeck /var/lib/whaledeck-agent /data/WhaleDeck/apps /data/DockerData /etc/docker
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# The .NET JIT requires executable code pages; keep the agent alive across
# Docker shutdown/restart and report dependency health through the UDS.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallArchitectures=native
# The process receives no ambient capabilities. The bounding set only permits
# the setuid helper to enter the root identity and write approved backup paths;
# sudoers and whaledeck-privileged still constrain every executable action.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_CHOWN CAP_AUDIT_WRITE
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
