# Host exposure: only the canonical internal service address is allowed.
WHALEDECK_BIND_IP=192.168.22.19
WHALEDECK_HTTP_PORT=8080
AUTHENTIK_HTTP_PORT=8081

# Dedicated PostgreSQL database and least-privilege role.
WHALEDECK_DB_NAME=whaledeck
WHALEDECK_DB_USER=whaledeck
WHALEDECK_DB_PASSWORD=replace-me

# Existing Valkey 9 service. Use a dedicated ACL user when provisioned.
WHALEDECK_VALKEY_USER=whaledeck
WHALEDECK_VALKEY_PASSWORD=replace-me

# Authentik confidential OIDC application.
WHALEDECK_OIDC_AUTHORITY=http://192.168.22.19:8081/application/o/whaledeck/
WHALEDECK_OIDC_CLIENT_ID=replace-me
WHALEDECK_OIDC_CLIENT_SECRET=replace-me

# Public runtime values injected into the Vue application at container start.
WHALEDECK_TITLE=WhaleDeck 协同平台
WHALEDECK_AUTHENTIK_URL=http://192.168.22.19:8081
WHALEDECK_GITLAB_URL=http://192.168.22.19:8082
