# Host exposure: only the canonical internal service address is allowed.
DASHBOARD_BIND_IP=192.168.22.19
DASHBOARD_HTTP_PORT=8080
AUTHENTIK_HTTP_PORT=8081

# Dedicated PostgreSQL database and least-privilege role.
DASHBOARD_DB_NAME=dashboard
DASHBOARD_DB_USER=dashboard
DASHBOARD_DB_PASSWORD=replace-me

# Existing Valkey 9 service. Use a dedicated ACL user when provisioned.
DASHBOARD_VALKEY_USER=dashboard
DASHBOARD_VALKEY_PASSWORD=replace-me

# Authentik confidential OIDC application.
DASHBOARD_OIDC_AUTHORITY=http://192.168.22.19:8081/application/o/dashboard/
DASHBOARD_OIDC_CLIENT_ID=replace-me
DASHBOARD_OIDC_CLIENT_SECRET=replace-me

# Public runtime values injected into the Vue application at container start.
DASHBOARD_TITLE=DCFS 协同平台
DASHBOARD_AUTHENTIK_URL=http://192.168.22.19:8081
DASHBOARD_GITLAB_URL=http://192.168.22.19:8082
